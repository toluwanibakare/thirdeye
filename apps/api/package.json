{
  "name": "thirdeye-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./app": "./dist/app.js",
    "./src/app": "./src/app.ts"
